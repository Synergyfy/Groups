# Copy this file to .env and adjust the values for your environment.
DATABASE_URL="postgresql://postgres:password@localhost:5432/247gbs_groups?schema=public"

# App ports
API_PORT=4089
WEB_PORT=4088
CORS_ORIGIN="http://localhost:4088"

# Local app session
AUTH_JWT_SECRET="replace-with-a-long-random-secret"
AUTH_COOKIE_NAME="chs_session"
AUTH_SESSION_TTL_SECONDS=28800

# Local administrator login (separate from Central Hub SSO).
# These values seed the database account; sign-in is checked against the DB.
ADMIN_EMAIL="admin@centralhubsolution.com"
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_NAME="Central Hub Administrator"

# MCOM Solutions Central Hub
MCOM_FRONTEND_URL="http://localhost:3000"
MCOM_SOLUTIONS_URL="http://localhost:3010"
MCOM_CLIENT_ID="mcom-group"
MCOM_CLIENT_SECRET="replace-with-central-hub-client-secret"
MCOM_API_KEY="replace-with-mcom-api-key"
MCOM_HMAC_SECRET="replace-with-mcom-hmac-secret"
MCOM_WEBHOOK_SECRET="replace-with-mcom-webhook-secret"
MCOM_PLATFORM_SLUG="group"
MCOM_REDIRECT_URI="http://localhost:4088/auth/callback"
MCOM_SCOPES="profile email business membership packages"
MCOM_WHITELABEL_ENABLED="false"
# Keep true in production. false lets authenticated Central Hub users in even
# when Central Hub reports entitlement.access.hasAccess = false.
MCOM_ENFORCE_ENTITLEMENTS="true"

# Direct app-to-app service mesh
MCOM_SERVICE_ENABLED="true"
MCOM_SERVICE_BASE_URL="http://localhost:4089"
MCOM_SERVICE_SCOPES="profile email service:read service:write"
MCOM_SERVICE_TOKEN_SCOPE="service:read"
# Comma-separated allowed callers. Empty = read policy from the central registry.
MCOM_ALLOWED_CALLERS=""

# Frontend API base. Leave as /api to use the Vite proxy.
# VITE_API_BASE_URL="/api"
