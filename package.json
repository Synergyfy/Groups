{
  "name": "247gbs-groups",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @247gbs/web dev",
    "dev:api": "pnpm --filter @247gbs/api dev",
    "db:generate": "pnpm --filter @247gbs/api db:generate",
    "db:migrate": "pnpm --filter @247gbs/api db:migrate",
    "db:push": "pnpm --filter @247gbs/api db:push",
    "db:seed": "pnpm --filter @247gbs/api db:seed",
    "db:studio": "pnpm --filter @247gbs/api db:studio",
    "mcom:smoke": "node --env-file=.env test-mcom-mesh.mjs",
    "admin:smoke": "node --env-file=.env test-admin-api.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
